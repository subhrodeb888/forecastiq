# Application
APP_NAME="ForecastIQ ML Service"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1
# DOCS_ENABLED=true              # defaults to true outside production

# Logging
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                   # structured JSON logs (auto-enabled in production)

# CORS (comma-separated origins, no spaces required)
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Database (PostgreSQL — standard URL, same database as the Next.js app;
# the SQLAlchemy/psycopg driver prefix is added automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forecastiq
DATABASE_ECHO=false                    # log every SQL statement
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Data pipeline
DEFAULT_TEST_FRACTION=0.2              # chronological holdout share per product
OUTLIER_IQR_MULTIPLIER=3.0             # IQR fence for winsorizing extreme daily totals

# Model training
MODEL_ARTIFACTS_DIR=artifacts          # where trained models/metrics are written
TRAINING_N_ESTIMATORS=300
TRAINING_MIN_SAMPLES_LEAF=2
TRAINING_RANDOM_STATE=42

# Forecasting
DEFAULT_HORIZON_DAYS=30
MAX_HORIZON_DAYS=90
MIN_HISTORY_POINTS=8
MAX_HISTORY_POINTS=730
DEFAULT_SEASON_LENGTH=7
PREDICTION_INTERVAL_Z=1.96
